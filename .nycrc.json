{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": true,
  "per-file": true,
  "extension": [".js", ".ts", ".tsx"],
  "include": ["src/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules/**", "coverage/**"],
  "reporter": ["lcov", "text"],
  "lines": 95,
  "functions": 95,
 "statements": 95,
  "branches": 90
}